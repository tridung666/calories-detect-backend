# Copy the required entries into the existing /opt/calories-detect/.env.
# Docker Compose only injects values explicitly referenced by each service.
# Backend runtime (enable the production profile).
SPRING_PROFILES_ACTIVE=prod
DB_HOST=postgres
DB_PORT=5432
DB_NAME=calories_detect
DB_USERNAME=calories_user
DB_PASSWORD=replace-with-a-strong-database-password
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes-long
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
AUTH_ALLOWED_ORIGINS=https://caloriesdetect.com
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
MAIL_USERNAME=your-sender@gmail.com
MAIL_PASSWORD=your-smtp-app-password

# Cloudinary: backend only, never frontend VITE_* variables.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Spring -> AI: containers must share a network with service DNS name ai.
AI_SERVICE_BASE_URL=http://ai:8000
AI_SERVICE_CONNECT_TIMEOUT=3s
AI_SERVICE_RESPONSE_TIMEOUT=75s

# OpenAI: inject only into the ai container.
OPENAI_API_KEY=replace-with-your-openai-key
OPENAI_MODEL=your-model-supporting-images-and-strict-structured-outputs
OPENAI_TIMEOUT_SECONDS=60

# Image tags used by existing VPS deployment pipelines.
BACKEND_TAG=sha-REPLACE_WITH_BACKEND_COMMIT
AI_TAG=sha-REPLACE_WITH_AI_COMMIT
FRONTEND_TAG=sha-REPLACE_WITH_FRONTEND_COMMIT

# Frontend build arguments are supplied by frontend CD, not runtime container env.
# VITE_API_BASE_URL=/api
# VITE_GOOGLE_CLIENT_ID must match GOOGLE_CLIENT_ID.

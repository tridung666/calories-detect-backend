APP_PORT=8080

POSTGRES_DB=calories_detect
POSTGRES_USER=calories_user
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5433

DB_HOST=localhost
DB_PORT=5433
DB_NAME=calories_detect
DB_USERNAME=calories_user
DB_PASSWORD=change-me

# Use a random value with at least 32 bytes in production.
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes-long
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Local HTTP only; the prod profile always uses Secure cookies.
AUTH_SECURE_COOKIES=false
# Optional exact origin allowlist. In prod leave unset for https://caloriesdetect.com.
# AUTH_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# OAuth 2.0 Web application client ID used by the frontend Google Sign-In flow.
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# SMTP account; for Gmail, use an app password rather than your account password.
MAIL_USERNAME=your-sender@gmail.com
MAIL_PASSWORD=your-smtp-app-password

# GitHub Actions / VPS deployment secrets.
# Add these in GitHub repository Settings > Secrets and variables > Actions.
VPS_HOST=your-vps-ip-or-domain
VPS_USER=your-vps-ssh-user
VPS_SSH_PORT=22
VPS_SSH_KEY=your-private-ssh-key
